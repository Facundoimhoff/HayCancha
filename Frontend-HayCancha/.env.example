# Copiar a .env.local (ignorado por git) y completar.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon/publishable key>   # nunca la service_role
# URL del backend de pagos (opcional; por defecto el de Render)
VITE_API_URL=https://haycancha.onrender.com
# Medición (opcionales; son identificadores públicos). Solo se usan si el visitante acepta las cookies.
# En producción se cargan en Vercel > Settings > Environment Variables y hay que redesplegar.
VITE_GA_ID=G-XXXXXXXXXX            # Google Analytics 4
VITE_META_PIXEL_ID=000000000000000 # Píxel de Meta (anuncios de Instagram/Facebook)
